#!/usr/bin/env python

# SCons 构建入口：把本模块所有源文件登记进 Godot 构建系统。
#
# **目录约定**：`register_types.*` / `SCsub` / `config.py` 留在模块根（引擎识别模块
# 要求这三者同在模块目录内），其余 `.cpp` / `.h` 统一放在 `src/` 下。
#
# 注：Import / env / env_modules 均为 SCons 运行时注入的全局，整文件静默该误报。
# pyright: reportUndefinedVariable = none

Import("env")
Import("env_modules")

# 克隆一份模块专用环境，避免污染共用环境配置。
env_custom_titlebar = env_modules.Clone()

# 头文件搜索路径：源码在 `src/` 下，以 `src/<文件>.h` 的形式引用。
env_custom_titlebar.Prepend(CPPPATH=["src"])

# 根目录源文件需单独登记：SCons 的 `**/*.cpp` 不包含根目录下的文件。
env_custom_titlebar.add_source_files(env.modules_sources, "*.cpp")
# `src/` 下一层的源文件要显式登记：`src/**/*.cpp` 的 `**` 只匹配子目录，
# 直接放在 `src/` 里的文件不会被收录。
env_custom_titlebar.add_source_files(env.modules_sources, "src/*.cpp")
# 递归登记 `src/` 各子目录下的源文件。
env_custom_titlebar.add_source_files(env.modules_sources, "src/**/*.cpp")
